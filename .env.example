# Local development environment for the Comvestec SaaS foundation.
# Values below come from the current compose defaults, README endpoints,
# and checked-in runtime assets where the repo already defines them.
# Classification used in this file:
# - seeded locally: the repository or local compose stack already defines a working value
# - generated during bootstrap: create or capture the value after the local service is running
# - external provider: supply the value from a provider outside the repo-local stack

# Host-run DSN for Bun scripts and local tooling.
# Container-to-container services should use POSTGRES_URL_INTERNAL instead.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PUBLIC_WEB_PORT=3000
PRODUCT_APP_PORT=3002
ADMIN_APP_PORT=3004
SUBSCRIBER_JOURNEY_API_PORT=3010

CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_SITE_URL=http://127.0.0.1:3211
CONVEX_DASHBOARD_PORT=6791
# Generated during bootstrap after the local Convex backend is running.
CONVEX_SELF_HOSTED_ADMIN_KEY=generate-after-running-generate_admin_key
CONVEX_INSTANCE_NAME=comvestec-foundation

POSTGRES_DB=comvestec
POSTGRES_USER=comvestec
POSTGRES_PASSWORD=comvestec
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://comvestec:comvestec@localhost:5432/comvestec
POSTGRES_URL_INTERNAL=postgresql://comvestec:comvestec@postgres:5432/comvestec

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=comvestec
KEYCLOAK_CLIENT_ID=saas-platform
# Seeded locally by ops/docker/identity/keycloak/realm-export.json.
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_BASE_URL=http://localhost:8080

# External provider values. Polar is not part of the local compose stack.
POLAR_API_KEY=set-from-polar-tenant-api-key
POLAR_API_URL=https://api.polar.sh
POLAR_WEBHOOK_SECRET=set-from-polar-webhook-endpoint

VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_VERSION=0.149.0
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3001
GRAFANA_BASE_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

GLITCHTIP_PORT=8001
GLITCHTIP_DOMAIN=http://localhost:8001
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost
GLITCHTIP_ENABLE_ADMIN=False
GLITCHTIP_ENABLE_OPENAPI=False
GLITCHTIP_ENABLE_LOGS=False
GLITCHTIP_ENABLE_UPTIME=False
GLITCHTIP_SECRET_KEY=glitchtip-local-dev-secret-change-before-sharing
GLITCHTIP_DATABASE_URL=postgres://comvestec:comvestec@postgres:5432/comvestec
GLITCHTIP_VALKEY_URL=redis://valkey:6379
GLITCHTIP_EMAIL_URL=consolemail://
# Generated during bootstrap after creating a local GlitchTip project.
ERROR_TRACKING_DSN=generate-after-creating-local-glitchtip-project

KETO_READ_PORT=4466
KETO_WRITE_PORT=4467
KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467
KETO_DSN=postgres://comvestec:comvestec@postgres:5432/comvestec?sslmode=disable

UNLEASH_PORT=4242
UNLEASH_URL=http://localhost:4242
# Seeded locally by the checked-in compose defaults.
UNLEASH_API_KEY=default:development.unleash-insecure-api-token
UNLEASH_API_TOKEN=default:development.unleash-insecure-api-token
UNLEASH_DATABASE_URL=postgres://comvestec:comvestec@postgres:5432/comvestec?sslmode=disable

MEILISEARCH_PORT=7700
MEILISEARCH_ENV=development
MEILISEARCH_MASTER_KEY=meili-master-key
MEILISEARCH_URL=http://localhost:7700
# Seeded locally by the checked-in compose defaults.
MEILISEARCH_API_KEY=meili-master-key

NOVU_PORT=3100
NOVU_API_URL=http://localhost:3100
# Generated during bootstrap or supplied by a managed Novu environment.
NOVU_API_KEY=generate-after-creating-local-or-managed-novu-api-key

OPENMETER_PORT=8889
OPENMETER_URL=http://localhost:8889
OPENMETER_POSTGRES_URL=postgres://comvestec:comvestec@postgres:5432/comvestec?sslmode=disable
# Operator-supplied when you enable authenticated OpenMeter access or use a managed endpoint.
OPENMETER_API_KEY=set-when-enabling-openmeter-auth

POSTAL_API_PORT=5000
POSTAL_API_URL=http://localhost:5000
POSTAL_FNAME=Admin
POSTAL_LNAME=User
POSTAL_EMAIL=admin@localhost
# Generated during bootstrap after creating a Postal API credential.
POSTAL_API_KEY=generate-after-creating-local-postal-api-key

# OpenPanel is available through the optional `analytics` profile in ops/docker/compose.yml.
# The analytics compose definition and local runtime assets live in ops/docker/analytics/.
OPENPANEL_PORT=3005
OPENPANEL_DASHBOARD_URL=http://localhost:3005
# Keep the `/api` suffix because the local OpenPanel proxy exposes the API under /api.
OPENPANEL_API_URL=http://localhost:3005/api
OPENPANEL_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3004
# The analytics profile uses these values for its own services.
OPENPANEL_IMAGE_TAG=2.0.0
OPENPANEL_ALLOW_REGISTRATION=false
OPENPANEL_ALLOW_INVITATION=true
OPENPANEL_BATCH_SIZE=5000
OPENPANEL_BATCH_INTERVAL=10000
OPENPANEL_DATABASE_URL=postgresql://postgres:postgres@op-db:5432/postgres?schema=public
OPENPANEL_DATABASE_URL_DIRECT=postgresql://postgres:postgres@op-db:5432/postgres?schema=public
OPENPANEL_REDIS_URL=redis://op-kv:6379
OPENPANEL_CLICKHOUSE_URL=http://op-ch:8123/openpanel
OPENPANEL_COOKIE_SECRET=openpanel-local-dev-secret-change-before-sharing
OPENPANEL_WORKER_REPLICAS=2
# Optional OpenPanel email delivery settings.
OPENPANEL_EMAIL_SENDER=
OPENPANEL_RESEND_API_KEY=
# Generated during bootstrap after creating the local OpenPanel project.
OPENPANEL_CLIENT_ID=generate-after-creating-local-openpanel-project

# Kong and Vault are available through the optional `hardened` profile in ops/docker/compose.yml.
# The security compose definition and local runtime assets live in ops/docker/security/.
KONG_PROXY_PORT=8000
KONG_PROXY_TLS_PORT=8443
KONG_ADMIN_API_PORT=18001
KONG_ADMIN_API_TLS_PORT=18444
KONG_ADMIN_GUI_PORT=18002
KONG_ADMIN_GUI_TLS_PORT=18445
KONG_ADMIN_GUI_URL=http://localhost:18002

VAULT_PORT=8200
VAULT_ADDR=http://localhost:8200
# Vault in the optional hardened profile starts in normal server mode and must be initialized and unsealed before use.
