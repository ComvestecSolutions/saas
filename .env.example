# Local development environment catalog for the Comvestec SaaS foundation.
# Keep tracked defaults here, keep optional non-secret host overrides in ignored
# .env.local, and run `bun run ops:secrets:bootstrap` after Vault is initialized
# and unsealed so generated local secrets land in Vault at
# `platform/local-ops/runtime-env` instead of a persistent repo-root .env file.
# Concrete values for placeholder-backed keys belong in Vault or one-off shell
# env only. Do not store them in `.env.local` or ad hoc env files.
# Canonical local Vault artifacts live outside the repo at:
# - ~/.vault-init.json
# - ~/.vault-unseal-key
# - ~/.vault-token
# - ~/.vault-local-runtime-token
# Repo-owned local tooling prefers ~/.vault-local-runtime-token for routine
# reads/writes to `platform/local-ops/runtime-env`; ~/.vault-token stays
# break-glass for Vault bootstrap and recovery.
# Optional one-off bootstrap overrides for token refresh/bootstrap flows:
# - VAULT_BOOTSTRAP_TOKEN
# - VAULT_BOOTSTRAP_TOKEN_FILE
# Prefer setting those only for the current command instead of persisting them.
# Classification used in this file:
# - generated locally before first start: generate the value with `bun run ops:secrets:bootstrap` before starting the full stack
# - generated during bootstrap: create or capture the value after the local service is running, then write it to Vault
# - external provider: supply the value from a provider outside the repo-local stack, preferably by writing it to Vault or setting it only for the current command

# Host-run DSN for Bun scripts and local tooling against the platform system-of-record database.
# Container-to-container platform services should use POSTGRES_URL_INTERNAL.
NODE_ENV=development
# Public web base URL used for first-party hosted checkout return allowlists
# and email-backed auth-start handoff links such as tenant invitations.
APP_BASE_URL=http://localhost:3000
PRODUCT_APP_BASE_URL=http://localhost:3002
# Admin app base URL used for governed first-party operator auth callback approval.
ADMIN_APP_BASE_URL=http://localhost:3004
PUBLIC_WEB_PORT=3000
PRODUCT_APP_PORT=3002
ADMIN_APP_PORT=3004
# Local backend API port used by the host-run subscriber journey server and
# rendered into Kong's backend-api upstream at container start.
SUBSCRIBER_JOURNEY_API_PORT=3010

CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_SITE_URL=http://127.0.0.1:3211
CONVEX_DASHBOARD_PORT=6791
# Generated during bootstrap after the local Convex backend is running.
CONVEX_SELF_HOSTED_ADMIN_KEY=generate-after-running-generate_admin_key
# After writing the generated admin key into Vault, run `bun run convex:env:sync:local`
# whenever deployment-managed worker values change so the Convex action runtime
# gets the current Postgres, Keycloak, Polar, Valkey, and Keto settings.
CONVEX_INSTANCE_NAME=comvestec-foundation

POSTGRES_DB=comvestec
POSTGRES_USER=comvestec
POSTGRES_PASSWORD=set-in-local-env__postgres_password
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://comvestec:set-in-local-env__postgres_password@localhost:5432/comvestec
POSTGRES_URL_INTERNAL=postgresql://comvestec:set-in-local-env__postgres_password@postgres:5432/comvestec
# Cluster-level Postgres URL only. Convex derives its database name from CONVEX_INSTANCE_NAME.
CONVEX_POSTGRES_URL=postgresql://comvestec:set-in-local-env__postgres_password@postgres:5432

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=keycloak.operator.local
KEYCLOAK_ADMIN_PASSWORD=set-in-local-env__keycloak_admin_password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_REALM=comvestec
KEYCLOAK_CLIENT_ID=saas-platform
# Rendered into the Keycloak realm import from the transient Vault-backed env file at container start.
KEYCLOAK_CLIENT_SECRET=set-in-local-env__keycloak_client_secret
KEYCLOAK_BASE_URL=http://localhost:8080
# Container-to-container services such as Convex workflow actions must use the internal host.
KEYCLOAK_BASE_URL_INTERNAL=http://keycloak:8080
# Generated locally before first start for authenticated Convex service-actor execution.
KEYCLOAK_CONVEX_SERVICE_ACTOR_USERNAME=convex.billing.service
KEYCLOAK_CONVEX_SERVICE_ACTOR_PASSWORD=set-in-local-env__keycloak_convex_service_actor_password

# Optional overrides for the backend subscriber-journey smoke tooling.
# The checked-in scripts fall back to the repo-local defaults below when these are unset.
SUBSCRIBER_JOURNEY_SMOKE_USER_USERNAME=smoke.owner
SUBSCRIBER_JOURNEY_SMOKE_USER_EMAIL=smoke.owner@local.test
SUBSCRIBER_JOURNEY_SMOKE_USER_PASSWORD=set-in-local-env__subscriber_journey_smoke_user_password
SUBSCRIBER_JOURNEY_SMOKE_USER_FIRST_NAME=Smoke
SUBSCRIBER_JOURNEY_SMOKE_USER_LAST_NAME=Owner
SUBSCRIBER_JOURNEY_SMOKE_TENANT_ID=org_smoke
SUBSCRIBER_JOURNEY_SMOKE_ENTERPRISE_ID=ent_smoke
SUBSCRIBER_JOURNEY_SMOKE_REDIRECT_URI=http://localhost:3002/auth/callback
SUBSCRIBER_JOURNEY_SMOKE_SUCCESS_URL=http://localhost:3002/billing/success
SUBSCRIBER_JOURNEY_SMOKE_CANCEL_URL=http://localhost:3002/billing/cancel
# Optional when you want externally reachable webhook or replay URLs.
# Local Polar CLI forwarding can target the localhost webhook endpoint directly.
# SUBSCRIBER_JOURNEY_PUBLIC_BASE_URL=https://set-public-tunnel-host-when-needed

# Required external-provider values. Polar is a current dependency even though it is not part of the repo-local compose stack.
# Subscriber journey and admin billing still read `POLAR_API_URL`; the newer admin projection/read/vendor slices
# decode the same host through `POLAR_API_BASE_URL`. Keep both base-url keys aligned to the same Polar host until
# the remaining provider-facing surfaces converge on one name.
POLAR_ACCESS_TOKEN=set-from-polar-organization-access-token
# Local validation defaults to the Polar sandbox host. If you intentionally point local tooling at another
# Polar environment, override both keys together so backend and admin surfaces stay aligned.
POLAR_API_URL=https://sandbox-api.polar.sh/v1
POLAR_API_BASE_URL=https://sandbox-api.polar.sh/v1
# For local development, run `polar listen http://127.0.0.1:3010/api/subscriber-journey/billing/webhooks/polar`
# and write the reported secret to the Vault-backed local runtime env before completing checkout.
POLAR_WEBHOOK_SECRET=set-from-polar-cli-listen-or-webhook-endpoint

VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
VALKEY_URL_INTERNAL=redis://valkey:6379

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_VERSION=0.151.0
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3001
GRAFANA_BASE_URL=http://localhost:3001
GRAFANA_ADMIN_USER=grafana.operator.local
GRAFANA_ADMIN_PASSWORD=set-in-local-env__grafana_admin_password

GLITCHTIP_PORT=8001
GLITCHTIP_DOMAIN=http://localhost:8001
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost
GLITCHTIP_ENABLE_ADMIN=False
GLITCHTIP_ENABLE_OPENAPI=False
GLITCHTIP_ENABLE_LOGS=False
GLITCHTIP_ENABLE_UPTIME=False
GLITCHTIP_SECRET_KEY=set-in-local-env__glitchtip_secret_key
GLITCHTIP_DATABASE_URL=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/glitchtip
# Generated locally before first start for the repo-owned GlitchTip UI operator login.
GLITCHTIP_OPERATOR_EMAIL=glitchtip.operator@example.com
GLITCHTIP_OPERATOR_PASSWORD=set-in-local-env__glitchtip_operator_password
GLITCHTIP_VALKEY_URL=redis://valkey:6379
GLITCHTIP_EMAIL_URL=consolemail://
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the local GlitchTip
# project, or supplied by a managed GlitchTip environment. Prefer the raw project DSN form with its public key
# (for example `https://public-key@glitchtip.example/1`) so backend document responses can derive the report-only
# GlitchTip browser security-report endpoint automatically; store-endpoint-only values still capture uncaught errors.
ERROR_TRACKING_DSN=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-glitchtip-dsn

KETO_READ_PORT=4466
KETO_WRITE_PORT=4467
KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467
KETO_READ_URL_INTERNAL=http://ory-keto:4466
KETO_WRITE_URL_INTERNAL=http://ory-keto:4467
KETO_DSN=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/keto?sslmode=disable

UNLEASH_PORT=4242
UNLEASH_URL=http://localhost:4242
UNLEASH_URL_INTERNAL=http://unleash:4242
# Generated locally before first start for repo-owned server-side feature evaluation and local Unleash bootstrap.
UNLEASH_API_KEY=default:development.set-in-local-env__unleash_backend_token
UNLEASH_API_TOKEN=default:development.set-in-local-env__unleash_backend_token
UNLEASH_DATABASE_URL=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/unleash?sslmode=disable
# Generated locally before first start for the repo-owned Unleash admin UI login.
UNLEASH_OPERATOR_USERNAME=unleash.operator.local
UNLEASH_OPERATOR_EMAIL=unleash.operator@example.com
UNLEASH_OPERATOR_PASSWORD=set-in-local-env__unleash_operator_password

MEILISEARCH_PORT=7700
MEILISEARCH_ENV=development
MEILISEARCH_MASTER_KEY=set-in-local-env__meilisearch_master_key
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_URL_INTERNAL=http://meilisearch:7700
# Generate a scoped API key after Meilisearch is running or reuse the master key locally.
MEILISEARCH_API_KEY=set-in-local-env__meilisearch_api_key

NOVU_PORT=3101
NOVU_API_URL=http://localhost:3101
NOVU_WEBSOCKET_PORT=3102
NOVU_WEBSOCKET_URL=http://localhost:3102
NOVU_DASHBOARD_PORT=3103
NOVU_LOG_LEVEL=warn
NOVU_FRONT_BASE_URL=http://localhost:3103
NOVU_DASHBOARD_URL=http://localhost:3103
# Generated locally before first start for the self-hosted Novu API and worker runtime.
NOVU_MONGO_INITDB_ROOT_USERNAME=novu
NOVU_MONGO_INITDB_ROOT_PASSWORD=set-in-local-env__novu_mongo_root_password
NOVU_MONGO_URL=mongodb://novu:set-in-local-env__novu_mongo_root_password@novu-mongo:27017/novu-db?authSource=admin
NOVU_JWT_SECRET=set-in-local-env__novu_jwt_secret
# Must stay a strong 32-character value for Novu credential encryption.
NOVU_STORE_ENCRYPTION_KEY=set-in-local-env__novu_store_encryption_key
NOVU_FNAME=Novu
NOVU_LNAME=Operator
# Vault-backed dashboard and auth bootstrap login for the repo-owned local Novu operator.
NOVU_EMAIL=novu.operator@local.test
NOVU_ORGANIZATION_NAME=Comvestec Local
NOVU_PASSWORD=set-in-local-env__novu_password
# Keep self-service registration disabled during normal local runtime. The runtime bootstrap command temporarily recreates
# Novu with registration enabled only while seeding the first operator and backend API key.
NOVU_DISABLE_USER_REGISTRATION=true
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` or supplied by a managed Novu environment.
NOVU_API_KEY=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-novu-api-key
# Typed Novu workflow identifier consumed by the admin-organization
# platform service when triggering invitation emails. Must match
# `novuWorkflowId.adminOrganizationInvitation`.
NOVU_WORKFLOW_ID_ADMIN_ORGANIZATION_INVITATION=admin-organization.invitation

# Admin-organization invitation lifetime in minutes. Mirrors the
# `adminOrganizationConfigKey.invitationTtlMinutes` manifest key and
# must be a positive integer. No in-service default — bootstrap is
# responsible for supplying a value.
ADMIN_ORGANIZATION_INVITATION_TTL_MINUTES=4320

# Manual break-glass platform service bounds. Mirror
# `manualBreakGlassConfigKey.*` manifest keys and MUST be positive
# integers — no in-service default. Operators set every key:
#   - MAX_TTL_MINUTES caps the grant lifetime accepted by issueGrant
#   - MAX_ACTIVE_GRANTS_PER_SUPPORT_OPERATOR caps concurrent grants
#     held by a single grantee
#   - CACHE_MAX_SIZE bounds the in-memory per-subject context cache
#     used by currentBreakGlassContextForActor
MANUAL_BREAK_GLASS_MAX_TTL_MINUTES=60
MANUAL_BREAK_GLASS_MAX_ACTIVE_GRANTS_PER_SUPPORT_OPERATOR=3
MANUAL_BREAK_GLASS_CACHE_MAX_SIZE=256

# Operator-facing webhook delivery envelope. Mirrors
# `operatorWebhookDeliveryConfigKey.*` manifest defaults (maxAttempts=6,
# backoffBaseSeconds=30, replayGuardWindowMinutes=1440,
# signatureFreshnessSeconds=300, responseBodySnippetMaxBytes=4096,
# cacheMaxSize=1024). All values MUST be positive integers — no
# in-service default. The subscription-secret provider env value is the
# static shared HMAC secret for local dev; the vault-backed
# per-subscription provider is a future swap. Operators MUST set every
# key — no synthesis or fallback in the platform runtime.
OPERATOR_WEBHOOK_DELIVERY_MAX_ATTEMPTS=6
OPERATOR_WEBHOOK_DELIVERY_BACKOFF_BASE_SECONDS=30
OPERATOR_WEBHOOK_DELIVERY_REPLAY_GUARD_WINDOW_MINUTES=1440
OPERATOR_WEBHOOK_DELIVERY_SIGNATURE_FRESHNESS_SECONDS=300
OPERATOR_WEBHOOK_DELIVERY_RESPONSE_BODY_SNIPPET_MAX_BYTES=4096
OPERATOR_WEBHOOK_DELIVERY_CACHE_MAX_SIZE=1024
OPERATOR_WEBHOOK_DELIVERY_SUBSCRIPTION_SECRET_PROVIDER=set-in-local-env__operator_webhook_delivery_hmac_secret

# Polar revenue projection module (admin-app implementation plan §9 item 7).
# `runPolarRevenueProjectionFromEnvironment` decodes the shared
# `POLAR_API_BASE_URL` + `POLAR_ACCESS_TOKEN` keys above with NO local
# fallback synthesis (security invariant — no synthesized credentials or URLs).
# The remaining three keys match the manifest defaults
# (snapshot.intervalMinutes=60, history.retentionDays=365, cache.maxSize=1024)
# and are required: operators MUST set every key. The Polar access token is
# classified `secret` and is never surfaced through the projection layer.
POLAR_REVENUE_PROJECTION_SNAPSHOT_INTERVAL_MINUTES=60
POLAR_REVENUE_PROJECTION_HISTORY_RETENTION_DAYS=365
POLAR_REVENUE_PROJECTION_CACHE_MAX_SIZE=1024

# OpenMeter usage query module (admin-app implementation plan §9 item 8).
# `OPENMETER_API_BASE_URL` + `OPENMETER_API_KEY` are decoded at the env
# boundary by `runOpenMeterUsageQueryFromEnvironment` with NO local fallback
# synthesis (security invariant — no synthesized credentials or URLs). The
# remaining three keys match the manifest defaults
# (queryCache.ttlSeconds=60, maxWindow.days=31, cache.maxSize=1024) and are
# required: operators MUST set every key. The OpenMeter API key is classified
# `secret` and is never surfaced through the usage query layer.
# `OPENMETER_API_BASE_URL` is the same OpenMeter endpoint the existing
# adapter consumes via `OPENMETER_URL`; the usage query module re-decodes
# it under its own variable to keep the env contract explicit.
OPENMETER_API_BASE_URL=http://localhost:8889
OPEN_METER_USAGE_QUERY_QUERY_CACHE_TTL_SECONDS=60
OPEN_METER_USAGE_QUERY_MAX_WINDOW_DAYS=31
OPEN_METER_USAGE_QUERY_CACHE_MAX_SIZE=1024
# `VENDOR_HEALTH_AGGREGATOR_*` are decoded at the env boundary by
# `runVendorHealthAggregatorFromEnvironment`
# (`packages/platform/src/services/domains/vendor-health-aggregator-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 9).
# `SNAPSHOT_CACHE_TTL_SECONDS` bounds the in-memory snapshot cache
# freshness via `isAggregateFresh`; `CACHE_MAX_SIZE` bounds the
# single-key snapshot cache eviction. Adapter credentials are
# reused from the existing `KEYCLOAK_*` / `POLAR_API_BASE_URL` /
# `POLAR_ACCESS_TOKEN` /
# `OPENMETER_API_*` / `UNLEASH_*` / `NOVU_API_*` / `POSTAL_API_*` /
# `ERROR_TRACKING_DSN` / `OPENPANEL_*` / `OTEL_*` / `GRAFANA_*` /
# `MEILISEARCH_*` / `CONVEX_SELF_HOSTED_*` / `VALKEY_URL` /
# `KETO_READ_URL` / `KETO_WRITE_URL` keys.
VENDOR_HEALTH_AGGREGATOR_SNAPSHOT_CACHE_TTL_SECONDS=30
VENDOR_HEALTH_AGGREGATOR_CACHE_MAX_SIZE=8
# `KEYCLOAK_USER_READ_*` are decoded at the env boundary by
# `runKeycloakUserReadFromEnvironment`
# (`packages/platform/src/services/domains/keycloak-user-read-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 10).
# `CACHE_MAX_SIZE` bounds the per-tenant snapshot + list caches via
# insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS` drives
# `isKeycloakUserSummaryFresh`; `DEFAULT_LIST_LIMIT` is used when
# the read input omits an explicit `limit`. Keycloak admin
# credentials are reused from the existing `KEYCLOAK_*` keys; no
# new adapter literal is introduced.
KEYCLOAK_USER_READ_CACHE_MAX_SIZE=256
KEYCLOAK_USER_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
KEYCLOAK_USER_READ_DEFAULT_LIST_LIMIT=25
# `KEYCLOAK_ROLE_READ_*` are decoded at the env boundary by
# `runKeycloakRoleReadFromEnvironment`
# (`packages/platform/src/services/domains/keycloak-role-read-service.ts`)
# with NO local fallbacks. `CACHE_MAX_SIZE` bounds the per-tenant
# role-detail cache via insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS`
# drives `isKeycloakRoleDetailFresh`. This slice reuses the existing
# `KEYCLOAK_*` and `KEYCLOAK_ADMIN*` credentials.
KEYCLOAK_ROLE_READ_CACHE_MAX_SIZE=256
KEYCLOAK_ROLE_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
# `POLAR_CUSTOMER_READ_*` are decoded at the env boundary by
# `runPolarCustomerReadFromEnvironment`
# (`packages/platform/src/services/domains/polar-customer-read-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 10).
# `CACHE_MAX_SIZE` bounds the per-tenant snapshot + list caches via
# insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS` drives
# `isPolarCustomerSummaryFresh`; `DEFAULT_LIST_LIMIT` is used when
# the read input omits an explicit `limit`. Polar credentials are
# reused from the existing `POLAR_API_BASE_URL` + `POLAR_ACCESS_TOKEN`
# keys; no new adapter literal is introduced.
POLAR_CUSTOMER_READ_CACHE_MAX_SIZE=256
POLAR_CUSTOMER_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
POLAR_CUSTOMER_READ_DEFAULT_LIST_LIMIT=25
# `OPEN_METER_METER_READ_*` are decoded at the env boundary by
# `runOpenMeterMeterReadFromEnvironment`
# (`packages/platform/src/services/domains/open-meter-meter-read-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 10).
# `CACHE_MAX_SIZE` bounds the per-tenant snapshot + list caches via
# insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS` drives
# `isOpenMeterMeterSummaryFresh`; `DEFAULT_LIST_LIMIT` is used when
# the read input omits an explicit `limit`. OpenMeter credentials are
# reused from the existing `OPENMETER_API_BASE_URL` + `OPENMETER_API_KEY`
# keys; no new adapter literal is introduced.
OPEN_METER_METER_READ_CACHE_MAX_SIZE=256
OPEN_METER_METER_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
OPEN_METER_METER_READ_DEFAULT_LIST_LIMIT=25
# `NOVU_DELIVERIES_READ_*` are decoded at the env boundary by
# `runNovuDeliveriesReadFromEnvironment`
# (`packages/platform/src/services/domains/novu-deliveries-read-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 10).
# `CACHE_MAX_SIZE` bounds the per-tenant snapshot + list caches via
# insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS` drives
# `isNovuDeliverySummaryFresh`; `DEFAULT_LIST_LIMIT` is used when
# the read input omits an explicit `limit`. Novu credentials are
# reused from the existing `NOVU_API_URL` + `NOVU_API_KEY` keys; no
# new adapter literal is introduced.
NOVU_DELIVERIES_READ_CACHE_MAX_SIZE=256
NOVU_DELIVERIES_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
NOVU_DELIVERIES_READ_DEFAULT_LIST_LIMIT=25
# `POSTAL_MAIL_LOG_READ_*` are decoded at the env boundary by
# `runPostalMailLogReadFromEnvironment`
# (`packages/platform/src/services/domains/postal-mail-log-read-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 10).
# `CACHE_MAX_SIZE` bounds the per-tenant snapshot + list caches via
# insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS` drives
# `isPostalMailLogEntryFresh`; `DEFAULT_LIST_LIMIT` is used when
# the read input omits an explicit `limit`. Postal credentials are
# reused from the existing `POSTAL_API_URL` + `POSTAL_API_KEY` keys;
# no new adapter literal is introduced.
POSTAL_MAIL_LOG_READ_CACHE_MAX_SIZE=256
POSTAL_MAIL_LOG_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
POSTAL_MAIL_LOG_READ_DEFAULT_LIST_LIMIT=25
# `GLITCHTIP_ISSUES_READ_*` are decoded at the env boundary by
# `runGlitchTipIssuesReadFromEnvironment`
# (`packages/platform/src/services/domains/glitchtip-issues-read-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 10).
# `CACHE_MAX_SIZE` bounds the per-tenant snapshot + list caches via
# insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS` drives
# `isGlitchTipIssueFresh`; `DEFAULT_LIST_LIMIT` is used when
# the read input omits an explicit `limit`. GlitchTip credentials are
# reused from the existing `ERROR_TRACKING_DSN` key; no new adapter
# literal is introduced.
GLITCHTIP_ISSUES_READ_CACHE_MAX_SIZE=256
GLITCHTIP_ISSUES_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
GLITCHTIP_ISSUES_READ_DEFAULT_LIST_LIMIT=25
# `OPENPANEL_EVENTS_READ_*` are decoded at the env boundary by
# `runOpenPanelEventsReadFromEnvironment`
# (`packages/platform/src/services/domains/openpanel-events-read-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 10).
# `CACHE_MAX_SIZE` bounds the per-tenant snapshot + list caches via
# insertion-order eviction; `SNAPSHOT_CACHE_TTL_SECONDS` drives
# `isOpenPanelEventFresh`; `DEFAULT_LIST_LIMIT` is used when
# the read input omits an explicit `limit`. OpenPanel credentials are
# reused from the existing `OPENPANEL_API_URL` + `OPENPANEL_CLIENT_ID`
# + `OPENPANEL_CLIENT_SECRET` keys; no new adapter literal is introduced.
OPENPANEL_EVENTS_READ_CACHE_MAX_SIZE=256
OPENPANEL_EVENTS_READ_SNAPSHOT_CACHE_TTL_SECONDS=60
OPENPANEL_EVENTS_READ_DEFAULT_LIST_LIMIT=25
# `UNIVERSAL_SEARCH_*` are decoded at the env boundary by
# `runUniversalSearchFromEnvironment`
# (`packages/platform/src/services/domains/universal-search-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 11).
# `PER_FACET_LIMIT_DEFAULT` is the per-bucket top-K when the caller
# omits `perFacetLimit`; `PER_FACET_LIMIT_MAX` is the hard ceiling
# enforced at the SERVICE layer (defense in depth above the contract
# 1..50 boundary). `CACHE_MAX_SIZE` bounds the in-memory result
# cache via insertion-order eviction; `CACHE_TTL_SECONDS` drives
# `isIndexFresh` for cached result freshness; `INDEX_FRESHNESS_
# THRESHOLD_SECONDS` flips `indexFreshness.isFresh` on the result
# envelope so the omnibar can warn operators when results are
# computed against a stale per-facet Meilisearch index. The
# Meilisearch credentials reuse the existing `MEILISEARCH_URL` +
# `MEILISEARCH_MASTER_KEY` keys; no new adapter literal is
# introduced.
UNIVERSAL_SEARCH_PER_FACET_LIMIT_DEFAULT=5
UNIVERSAL_SEARCH_PER_FACET_LIMIT_MAX=20
UNIVERSAL_SEARCH_CACHE_MAX_SIZE=256
UNIVERSAL_SEARCH_CACHE_TTL_SECONDS=30
UNIVERSAL_SEARCH_INDEX_FRESHNESS_THRESHOLD_SECONDS=600

# `CAPABILITY_SNAPSHOT_V2_*` are decoded at the env boundary by
# `runCapabilitySnapshotV2FromEnvironment`
# (`packages/platform/src/services/access/capability-snapshot-v2-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 13).
# `CACHE_MAX_SIZE` bounds the in-memory per-actor capability-snapshot
# cache via insertion-order eviction (backend instructions security
# invariant #5); `CACHE_TTL_SECONDS` bounds cached snapshot freshness
# so stale entries trigger a live re-derivation including a fresh
# AdminOrganizationService role lookup. The service reuses the
# existing `POSTGRES_URL` key for the admin-organization repository
# join; no new adapter literal is introduced.
CAPABILITY_SNAPSHOT_V2_CACHE_MAX_SIZE=256
CAPABILITY_SNAPSHOT_V2_CACHE_TTL_SECONDS=30

# `RUN_AS_BANNER_STATE_*` are decoded at the env boundary by
# `runRunAsBannerStateFromEnvironment`
# (`packages/platform/src/services/access/run-as-banner-state-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 14).
# `CACHE_MAX_SIZE` bounds the in-memory per-actor run-as banner cache
# via insertion-order eviction (backend instructions security
# invariant #5); `CACHE_TTL_SECONDS` is intentionally short (≈ 5s)
# so the displayed `secondsRemaining` stays in sync with the
# underlying break-glass grant's `expiresAt`. The service reuses
# the existing `POSTGRES_URL` key for the manual-break-glass
# repository + admin-organization role lookup; no new adapter
# literal is introduced.
RUN_AS_BANNER_STATE_CACHE_MAX_SIZE=256
RUN_AS_BANNER_STATE_CACHE_TTL_SECONDS=5

# `WORKFLOW_RUNS_ADMIN_*` are decoded at the env boundary by
# `runWorkflowRunsAdminFromEnvironment`
# (`packages/platform/src/services/domains/workflow-runs-admin-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 15).
# `CACHE_MAX_SIZE` bounds the in-memory list-result cache via
# insertion-order eviction (backend instructions security invariant
# #5); `CACHE_TTL_SECONDS` bounds cached list freshness so stale
# entries trigger a live re-derivation through the workflow-jobs
# admin port. `LIST_PAGE_SIZE_MAX` caps the decoded list `pageSize`
# at the service boundary so callers cannot widen the projection
# beyond the platform-owned ceiling. The service reuses the
# existing `POSTGRES_URL` key for the audit-log + admin-organization
# role-lookup join; no new adapter literal is introduced.
WORKFLOW_RUNS_ADMIN_CACHE_MAX_SIZE=128
WORKFLOW_RUNS_ADMIN_CACHE_TTL_SECONDS=30
WORKFLOW_RUNS_ADMIN_LIST_PAGE_SIZE_MAX=100

# `NOTIFICATION_CENTER_ADMIN_*` are decoded at the env boundary by
# `runNotificationCenterAdminFromEnvironment`
# (`packages/platform/src/services/domains/notification-center-admin-service.ts`)
# with NO local fallbacks (admin-app implementation plan §9 item 16 —
# final Phase 1 backend gap). `CACHE_MAX_SIZE` bounds the in-memory
# list-result cache via insertion-order eviction (backend
# instructions security invariant #5); `CACHE_TTL_SECONDS` bounds
# cached list freshness so stale entries trigger a live
# re-derivation through the Novu-backed notification-center admin
# port. `LIST_PAGE_SIZE_MAX` caps the decoded list `pageSize` at
# the service boundary so callers cannot widen the projection
# beyond the platform-owned ceiling. The service reuses the
# existing `POSTGRES_URL` key for the audit-log +
# admin-organization role-lookup join; no new adapter literal is
# introduced.
NOTIFICATION_CENTER_ADMIN_CACHE_MAX_SIZE=128
NOTIFICATION_CENTER_ADMIN_CACHE_TTL_SECONDS=30
NOTIFICATION_CENTER_ADMIN_LIST_PAGE_SIZE_MAX=100

OPENMETER_PORT=8889
OPENMETER_URL=http://localhost:8889
OPENMETER_POSTGRES_URL=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/openmeter?sslmode=disable
# Generated locally before first start for backend-owned OpenMeter ingest requests.
OPENMETER_API_KEY=set-in-local-env__openmeter_api_key

POSTAL_API_PORT=5000
POSTAL_API_URL=http://localhost:5000
# Seeded locally for backend-owned transactional email delivery defaults.
PLATFORM_EMAIL_SENDER_DISPLAY_NAME=Comvestec Platform
PLATFORM_EMAIL_SENDER_FROM_EMAIL=support@localhost
PLATFORM_EMAIL_SENDER_REPLY_TO_EMAIL=reply@localhost
POSTAL_MARIADB_DATABASE=postal
POSTAL_MARIADB_USERNAME=postal
POSTAL_WEB_PROTOCOL=http
POSTAL_WEB_HOSTNAME=localhost
POSTAL_SMTP_HOSTNAME=localhost
# Generated locally before first start for the self-hosted Postal database, Rails runtime, and signing-key bootstrap.
POSTAL_MARIADB_PASSWORD=set-in-local-env__postal_mariadb_password
POSTAL_RAILS_SECRET_KEY=set-in-local-env__postal_rails_secret_key
POSTAL_SIGNING_KEY_BASE64=set-in-local-env__postal_signing_key_base64
POSTAL_FNAME=Postal
POSTAL_LNAME=Operator
POSTAL_EMAIL=postal.operator@local.test
# Generated locally before first start for the local Postal operator used to mint the backend API credential.
POSTAL_PASSWORD=set-in-local-env__postal_password
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the Postal backend API
# credential.
POSTAL_API_KEY=generate-after-running-ops-runtime-bootstrap-or-creating-managed-postal-api-key

# OpenPanel is a current platform dependency and starts through the main ops/docker/compose.yml entrypoint.
# The analytics compose definition and local runtime assets live in ops/docker/analytics/.
OPENPANEL_PORT=3005
OPENPANEL_DASHBOARD_URL=http://localhost:3005
# Keep the `/api` suffix because the local OpenPanel proxy exposes the API under /api.
OPENPANEL_API_URL=http://localhost:3005/api
OPENPANEL_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3004
# The analytics profile uses these values for the current OpenPanel deployment services.
OPENPANEL_IMAGE_TAG=2.0.0
OPENPANEL_ALLOW_REGISTRATION=false
OPENPANEL_ALLOW_INVITATION=true
OPENPANEL_BATCH_SIZE=5000
OPENPANEL_BATCH_INTERVAL=10000
OPENPANEL_POSTGRES_USER=openpanel
OPENPANEL_POSTGRES_PASSWORD=set-in-local-env__openpanel_postgres_password
OPENPANEL_POSTGRES_DB=openpanel
OPENPANEL_DATABASE_URL=postgresql://openpanel:set-in-local-env__openpanel_postgres_password@op-db:5432/openpanel?schema=public
OPENPANEL_DATABASE_URL_DIRECT=postgresql://openpanel:set-in-local-env__openpanel_postgres_password@op-db:5432/openpanel?schema=public
OPENPANEL_REDIS_URL=redis://op-kv:6379
OPENPANEL_CLICKHOUSE_URL=http://op-ch:8123/openpanel
OPENPANEL_COOKIE_SECRET=set-in-local-env__openpanel_cookie_secret
# Generated locally before first start for the repo-owned OpenPanel dashboard operator login.
OPENPANEL_OPERATOR_EMAIL=openpanel.operator@local.test
OPENPANEL_OPERATOR_PASSWORD=set-in-local-env__openpanel_operator_password
# Optional OpenPanel email delivery settings.
OPENPANEL_EMAIL_SENDER=
OPENPANEL_RESEND_API_KEY=
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the local
# OpenPanel backend client, or supplied by a managed OpenPanel environment.
OPENPANEL_CLIENT_ID=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-openpanel-client-id
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the local
# OpenPanel backend client secret, or supplied by a managed OpenPanel environment.
OPENPANEL_CLIENT_SECRET=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-openpanel-client-secret

# Kong and Vault are current platform dependencies and start through the main ops/docker/compose.yml entrypoint.
# The security compose definition and local runtime assets live in ops/docker/security/.
KONG_PROXY_PORT=8000
KONG_PROXY_TLS_PORT=8443
KONG_ADMIN_API_PORT=18001
KONG_ADMIN_API_TLS_PORT=18444
KONG_ADMIN_GUI_PORT=18002
KONG_ADMIN_GUI_TLS_PORT=18445
KONG_ADMIN_GUI_URL=http://localhost:18002

VAULT_PORT=8200
VAULT_ADDR=http://localhost:8200
# Vault in the hardened profile starts in normal server mode and must be initialized and unsealed before use.
# Re-run `bun run ops:secrets:bootstrap` after Vault reinitialization to refresh
# the scoped ~/.vault-local-runtime-token file from the break-glass ~/.vault-token.


# Generated locally before first start for the admin-operator-test-tokens HMAC-SHA-256 signing key.
# The platform service refuses to construct without this value; rotation procedure is documented in
# specs/04-ops/runbooks/admin-operator-test-tokens-key-rotation.md.
ADMIN_OPERATOR_TEST_TOKENS_SIGNING_KEY=set-in-local-env__admin_operator_test_tokens_signing_key
# Default and maximum issued-token lifetimes for the admin-operator-test-tokens module. The
# UI defaults the expiry picker to ADMIN_OPERATOR_TEST_TOKENS_DEFAULT_EXPIRY_HOURS and rejects
# issue requests above ADMIN_OPERATOR_TEST_TOKENS_MAX_EXPIRY_HOURS at the service boundary.
ADMIN_OPERATOR_TEST_TOKENS_DEFAULT_EXPIRY_HOURS=8
ADMIN_OPERATOR_TEST_TOKENS_MAX_EXPIRY_HOURS=72

# ─────────────────────────────────────────────────────────────────────────────
# Phase 8 Playwright operator-journey e2e bindings (admin-app spec §11 Phase 8).
# The trusted-session fixture under `packages/e2e/tests/fixtures/trusted-session.ts`
# loads these values. The suite SKIPS instead of synthesizing localhost
# credentials when any value is unset.
# ─────────────────────────────────────────────────────────────────────────────
# Admin app live Playwright suites (`test:e2e`, `test:visual`, `test:a11y`).
# Always required:
#   - ADMIN_E2E_BASE_URL
#   - ADMIN_E2E_TENANT_ID
#   - ADMIN_E2E_INVITE_EMAIL
#   - ADMIN_E2E_TOKEN_LABEL
# Then provide ONE auth mode:
#   - Trusted cookie mode:
#       ADMIN_E2E_TRUSTED_SESSION_COOKIE_NAME
#       ADMIN_E2E_TRUSTED_SESSION_COOKIE_VALUE
#   - Real operator sign-in mode:
#       ADMIN_E2E_OPERATOR_USERNAME
#       ADMIN_E2E_OPERATOR_PASSWORD
# When using real operator sign-in locally, set ADMIN_E2E_BASE_URL to the same
# origin the auth callback returns to (typically http://localhost:3004).
ADMIN_E2E_BASE_URL=set-in-local-env__admin_e2e_base_url
ADMIN_E2E_TRUSTED_SESSION_COOKIE_NAME=set-in-local-env__admin_e2e_trusted_session_cookie_name
ADMIN_E2E_TRUSTED_SESSION_COOKIE_VALUE=set-in-local-env__admin_e2e_trusted_session_cookie_value
ADMIN_E2E_OPERATOR_USERNAME=set-in-local-env__admin_e2e_operator_username
ADMIN_E2E_OPERATOR_PASSWORD=set-in-local-env__admin_e2e_operator_password
ADMIN_E2E_TENANT_ID=set-in-local-env__admin_e2e_tenant_id
ADMIN_E2E_INVITE_EMAIL=set-in-local-env__admin_e2e_invite_email
ADMIN_E2E_TOKEN_LABEL=set-in-local-env__admin_e2e_token_label
