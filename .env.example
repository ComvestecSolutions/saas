# Local development environment catalog for the Comvestec SaaS foundation.
# Keep tracked defaults here, keep optional non-secret host overrides in ignored
# .env.local, and run `bun run ops:secrets:bootstrap` after Vault is initialized
# and unsealed so generated local secrets land in Vault at
# `platform/local-ops/runtime-env` instead of a persistent repo-root .env file.
# Concrete values for placeholder-backed keys belong in Vault or one-off shell
# env only. Do not store them in `.env.local` or ad hoc env files.
# Classification used in this file:
# - generated locally before first start: generate the value with `bun run ops:secrets:bootstrap` before starting the full stack
# - generated during bootstrap: create or capture the value after the local service is running, then write it to Vault
# - external provider: supply the value from a provider outside the repo-local stack, preferably by writing it to Vault or setting it only for the current command

# Host-run DSN for Bun scripts and local tooling against the platform system-of-record database.
# Container-to-container platform services should use POSTGRES_URL_INTERNAL.
NODE_ENV=development
# Public web base URL used for first-party hosted checkout return allowlists
# and email-backed auth-start handoff links such as tenant invitations.
APP_BASE_URL=http://localhost:3000
PRODUCT_APP_BASE_URL=http://localhost:3002
PUBLIC_WEB_PORT=3000
PRODUCT_APP_PORT=3002
ADMIN_APP_PORT=3004
# Local backend API port used by the host-run subscriber journey server and
# rendered into Kong's backend-api upstream at container start.
SUBSCRIBER_JOURNEY_API_PORT=3010

CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_SITE_URL=http://127.0.0.1:3211
CONVEX_DASHBOARD_PORT=6791
# Generated during bootstrap after the local Convex backend is running.
CONVEX_SELF_HOSTED_ADMIN_KEY=generate-after-running-generate_admin_key
# After writing the generated admin key into Vault, run `bun run convex:env:sync:local`
# whenever deployment-managed worker values change so the Convex action runtime
# gets the current Postgres, Keycloak, Polar, Valkey, and Keto settings.
CONVEX_INSTANCE_NAME=comvestec-foundation

POSTGRES_DB=comvestec
POSTGRES_USER=comvestec
POSTGRES_PASSWORD=set-in-local-env__postgres_password
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://comvestec:set-in-local-env__postgres_password@localhost:5432/comvestec
POSTGRES_URL_INTERNAL=postgresql://comvestec:set-in-local-env__postgres_password@postgres:5432/comvestec
# Cluster-level Postgres URL only. Convex derives its database name from CONVEX_INSTANCE_NAME.
CONVEX_POSTGRES_URL=postgresql://comvestec:set-in-local-env__postgres_password@postgres:5432

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=keycloak.operator.local
KEYCLOAK_ADMIN_PASSWORD=set-in-local-env__keycloak_admin_password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_REALM=comvestec
KEYCLOAK_CLIENT_ID=saas-platform
# Rendered into the Keycloak realm import from the transient Vault-backed env file at container start.
KEYCLOAK_CLIENT_SECRET=set-in-local-env__keycloak_client_secret
KEYCLOAK_BASE_URL=http://localhost:8080
# Container-to-container services such as Convex workflow actions must use the internal host.
KEYCLOAK_BASE_URL_INTERNAL=http://keycloak:8080
# Generated locally before first start for authenticated Convex service-actor execution.
KEYCLOAK_CONVEX_SERVICE_ACTOR_USERNAME=convex.billing.service
KEYCLOAK_CONVEX_SERVICE_ACTOR_PASSWORD=set-in-local-env__keycloak_convex_service_actor_password

# Optional overrides for the backend subscriber-journey smoke tooling.
# The checked-in scripts fall back to the repo-local defaults below when these are unset.
SUBSCRIBER_JOURNEY_SMOKE_USER_USERNAME=smoke.owner
SUBSCRIBER_JOURNEY_SMOKE_USER_EMAIL=smoke.owner@local.test
SUBSCRIBER_JOURNEY_SMOKE_USER_PASSWORD=set-in-local-env__subscriber_journey_smoke_user_password
SUBSCRIBER_JOURNEY_SMOKE_USER_FIRST_NAME=Smoke
SUBSCRIBER_JOURNEY_SMOKE_USER_LAST_NAME=Owner
SUBSCRIBER_JOURNEY_SMOKE_TENANT_ID=org_smoke
SUBSCRIBER_JOURNEY_SMOKE_ENTERPRISE_ID=ent_smoke
SUBSCRIBER_JOURNEY_SMOKE_REDIRECT_URI=http://localhost:3002/auth/callback
SUBSCRIBER_JOURNEY_SMOKE_SUCCESS_URL=http://localhost:3002/billing/success
SUBSCRIBER_JOURNEY_SMOKE_CANCEL_URL=http://localhost:3002/billing/cancel
# Optional when you want externally reachable webhook or replay URLs.
# Local Polar CLI forwarding can target the localhost webhook endpoint directly.
# SUBSCRIBER_JOURNEY_PUBLIC_BASE_URL=https://set-public-tunnel-host-when-needed

# Required external-provider values. Polar is a current dependency even though it is not part of the repo-local compose stack.
POLAR_ACCESS_TOKEN=set-from-polar-organization-access-token
# Override in `.env.local` to `https://sandbox-api.polar.sh/v1` when local validation uses a sandbox-scoped Polar organization access token.
POLAR_API_URL=https://api.polar.sh
# For local development, run `polar listen http://127.0.0.1:3010/api/subscriber-journey/billing/webhooks/polar`
# and write the reported secret to the Vault-backed local runtime env before completing checkout.
POLAR_WEBHOOK_SECRET=set-from-polar-cli-listen-or-webhook-endpoint

VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379
VALKEY_URL_INTERNAL=redis://valkey:6379

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_COLLECTOR_VERSION=0.149.0
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
GRAFANA_PORT=3001
GRAFANA_BASE_URL=http://localhost:3001
GRAFANA_ADMIN_USER=grafana.operator.local
GRAFANA_ADMIN_PASSWORD=set-in-local-env__grafana_admin_password

GLITCHTIP_PORT=8001
GLITCHTIP_DOMAIN=http://localhost:8001
GLITCHTIP_DEFAULT_FROM_EMAIL=glitchtip@localhost
GLITCHTIP_ENABLE_ADMIN=False
GLITCHTIP_ENABLE_OPENAPI=False
GLITCHTIP_ENABLE_LOGS=False
GLITCHTIP_ENABLE_UPTIME=False
GLITCHTIP_SECRET_KEY=set-in-local-env__glitchtip_secret_key
GLITCHTIP_DATABASE_URL=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/glitchtip
# Generated locally before first start for the repo-owned GlitchTip UI operator login.
GLITCHTIP_OPERATOR_EMAIL=glitchtip.operator@local.test
GLITCHTIP_OPERATOR_PASSWORD=set-in-local-env__glitchtip_operator_password
GLITCHTIP_VALKEY_URL=redis://valkey:6379
GLITCHTIP_EMAIL_URL=consolemail://
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the local GlitchTip
# project, or supplied by a managed GlitchTip environment. Prefer the raw project DSN form with its public key
# (for example `https://public-key@glitchtip.example/1`) so backend document responses can derive the report-only
# GlitchTip browser security-report endpoint automatically; store-endpoint-only values still capture uncaught errors.
ERROR_TRACKING_DSN=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-glitchtip-dsn

KETO_READ_PORT=4466
KETO_WRITE_PORT=4467
KETO_READ_URL=http://localhost:4466
KETO_WRITE_URL=http://localhost:4467
KETO_READ_URL_INTERNAL=http://ory-keto:4466
KETO_WRITE_URL_INTERNAL=http://ory-keto:4467
KETO_DSN=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/keto?sslmode=disable

UNLEASH_PORT=4242
UNLEASH_URL=http://localhost:4242
UNLEASH_URL_INTERNAL=http://unleash:4242
# Generated locally before first start for repo-owned server-side feature evaluation and local Unleash bootstrap.
UNLEASH_API_KEY=default:development.set-in-local-env__unleash_backend_token
UNLEASH_API_TOKEN=default:development.set-in-local-env__unleash_backend_token
UNLEASH_DATABASE_URL=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/unleash?sslmode=disable
# Generated locally before first start for the repo-owned Unleash admin UI login.
UNLEASH_OPERATOR_USERNAME=unleash.operator.local
UNLEASH_OPERATOR_EMAIL=unleash.operator@example.com
UNLEASH_OPERATOR_PASSWORD=set-in-local-env__unleash_operator_password

MEILISEARCH_PORT=7700
MEILISEARCH_ENV=development
MEILISEARCH_MASTER_KEY=set-in-local-env__meilisearch_master_key
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_URL_INTERNAL=http://meilisearch:7700
# Generate a scoped API key after Meilisearch is running or reuse the master key locally.
MEILISEARCH_API_KEY=set-in-local-env__meilisearch_api_key

NOVU_PORT=3101
NOVU_API_URL=http://localhost:3101
NOVU_WEBSOCKET_PORT=3102
NOVU_WEBSOCKET_URL=http://localhost:3102
NOVU_DASHBOARD_PORT=3103
NOVU_LOG_LEVEL=warn
NOVU_FRONT_BASE_URL=http://localhost:3103
NOVU_DASHBOARD_URL=http://localhost:3103
# Generated locally before first start for the self-hosted Novu API and worker runtime.
NOVU_MONGO_INITDB_ROOT_USERNAME=novu
NOVU_MONGO_INITDB_ROOT_PASSWORD=set-in-local-env__novu_mongo_root_password
NOVU_MONGO_URL=mongodb://novu:set-in-local-env__novu_mongo_root_password@novu-mongo:27017/novu-db?authSource=admin
NOVU_JWT_SECRET=set-in-local-env__novu_jwt_secret
# Must stay a strong 32-character value for Novu credential encryption.
NOVU_STORE_ENCRYPTION_KEY=set-in-local-env__novu_store_encryption_key
NOVU_FNAME=Novu
NOVU_LNAME=Operator
# Vault-backed dashboard and auth bootstrap login for the repo-owned local Novu operator.
NOVU_EMAIL=novu.operator@local.test
NOVU_ORGANIZATION_NAME=Comvestec Local
NOVU_PASSWORD=set-in-local-env__novu_password
# Keep self-service registration disabled during normal local runtime. The runtime bootstrap command temporarily recreates
# Novu with registration enabled only while seeding the first operator and backend API key.
NOVU_DISABLE_USER_REGISTRATION=true
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` or supplied by a managed Novu environment.
NOVU_API_KEY=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-novu-api-key

OPENMETER_PORT=8889
OPENMETER_URL=http://localhost:8889
OPENMETER_POSTGRES_URL=postgres://comvestec:set-in-local-env__postgres_password@postgres:5432/openmeter?sslmode=disable
# Generated locally before first start for backend-owned OpenMeter ingest requests.
OPENMETER_API_KEY=set-in-local-env__openmeter_api_key

POSTAL_API_PORT=5000
POSTAL_API_URL=http://localhost:5000
# Seeded locally for backend-owned transactional email delivery defaults.
PLATFORM_EMAIL_SENDER_DISPLAY_NAME=Comvestec Platform
PLATFORM_EMAIL_SENDER_FROM_EMAIL=support@localhost
PLATFORM_EMAIL_SENDER_REPLY_TO_EMAIL=reply@localhost
POSTAL_MARIADB_DATABASE=postal
POSTAL_MARIADB_USERNAME=postal
POSTAL_WEB_PROTOCOL=http
POSTAL_WEB_HOSTNAME=localhost
POSTAL_SMTP_HOSTNAME=localhost
# Generated locally before first start for the self-hosted Postal database, Rails runtime, and signing-key bootstrap.
POSTAL_MARIADB_PASSWORD=set-in-local-env__postal_mariadb_password
POSTAL_RAILS_SECRET_KEY=set-in-local-env__postal_rails_secret_key
POSTAL_SIGNING_KEY_BASE64=set-in-local-env__postal_signing_key_base64
POSTAL_FNAME=Postal
POSTAL_LNAME=Operator
POSTAL_EMAIL=postal.operator@local.test
# Generated locally before first start for the local Postal operator used to mint the backend API credential.
POSTAL_PASSWORD=set-in-local-env__postal_password
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the Postal backend API
# credential.
POSTAL_API_KEY=generate-after-running-ops-runtime-bootstrap-or-creating-managed-postal-api-key

# OpenPanel is a current platform dependency and starts through the main ops/docker/compose.yml entrypoint.
# The analytics compose definition and local runtime assets live in ops/docker/analytics/.
OPENPANEL_PORT=3005
OPENPANEL_DASHBOARD_URL=http://localhost:3005
# Keep the `/api` suffix because the local OpenPanel proxy exposes the API under /api.
OPENPANEL_API_URL=http://localhost:3005/api
OPENPANEL_API_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3004
# The analytics profile uses these values for the current OpenPanel deployment services.
OPENPANEL_IMAGE_TAG=2.0.0
OPENPANEL_ALLOW_REGISTRATION=false
OPENPANEL_ALLOW_INVITATION=true
OPENPANEL_BATCH_SIZE=5000
OPENPANEL_BATCH_INTERVAL=10000
OPENPANEL_POSTGRES_USER=openpanel
OPENPANEL_POSTGRES_PASSWORD=set-in-local-env__openpanel_postgres_password
OPENPANEL_POSTGRES_DB=openpanel
OPENPANEL_DATABASE_URL=postgresql://openpanel:set-in-local-env__openpanel_postgres_password@op-db:5432/openpanel?schema=public
OPENPANEL_DATABASE_URL_DIRECT=postgresql://openpanel:set-in-local-env__openpanel_postgres_password@op-db:5432/openpanel?schema=public
OPENPANEL_REDIS_URL=redis://op-kv:6379
OPENPANEL_CLICKHOUSE_URL=http://op-ch:8123/openpanel
OPENPANEL_COOKIE_SECRET=set-in-local-env__openpanel_cookie_secret
# Generated locally before first start for the repo-owned OpenPanel dashboard operator login.
OPENPANEL_OPERATOR_EMAIL=openpanel.operator@local.test
OPENPANEL_OPERATOR_PASSWORD=set-in-local-env__openpanel_operator_password
# Optional OpenPanel email delivery settings.
OPENPANEL_EMAIL_SENDER=
OPENPANEL_RESEND_API_KEY=
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the local
# OpenPanel backend client, or supplied by a managed OpenPanel environment.
OPENPANEL_CLIENT_ID=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-openpanel-client-id
# Generated during runtime bootstrap with `bun run ops:runtime:bootstrap` after creating or reusing the local
# OpenPanel backend client secret, or supplied by a managed OpenPanel environment.
OPENPANEL_CLIENT_SECRET=generate-after-running-ops-runtime-bootstrap-or-supplying-managed-openpanel-client-secret

# Kong and Vault are current platform dependencies and start through the main ops/docker/compose.yml entrypoint.
# The security compose definition and local runtime assets live in ops/docker/security/.
KONG_PROXY_PORT=8000
KONG_PROXY_TLS_PORT=8443
KONG_ADMIN_API_PORT=18001
KONG_ADMIN_API_TLS_PORT=18444
KONG_ADMIN_GUI_PORT=18002
KONG_ADMIN_GUI_TLS_PORT=18445
KONG_ADMIN_GUI_URL=http://localhost:18002

VAULT_PORT=8200
VAULT_ADDR=http://localhost:8200
# Vault in the hardened profile starts in normal server mode and must be initialized and unsealed before use.
