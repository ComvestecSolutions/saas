        "http://localhost:3000",
        "http://localhost:3002",
        "http://localhost:3004"
      ],
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true
    }
  ],
  "roles": {
    "realm": [
      { "name": "platform-admin" },
      { "name": "support-operator" },
      { "name": "tenant-admin" }
    ]
