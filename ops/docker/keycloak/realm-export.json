{
  "realm": "comvestec",
  "enabled": true,
  "displayName": "Comvestec SaaS Foundation",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "saas-platform",
