{
  "realm": "comvestec",
  "enabled": true,
  "displayName": "Comvestec SaaS Foundation",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "saas-platform",
      "name": "Comvestec SaaS Platform",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "__KEYCLOAK_CLIENT_SECRET__",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3002/*",
        "http://localhost:3004/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:3002",
        "http://localhost:3004"
      ],
      "protocolMappers": [
        {
          "name": "comvestec-actor-type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "comvestec_actor_type",
            "jsonType.label": "String",
            "user.attribute": "comvestec_actor_type"
          }
        }
      ],
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true
    }
  ],
  "roles": {
    "realm": [
      { "name": "platform-admin" },
      { "name": "support-operator" },
      { "name": "tenant-admin" }
    ]
  }
}
