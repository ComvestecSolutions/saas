{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@comvestec/contracts": ["packages/contracts/src/index.ts"],
      "@comvestec/config": ["packages/config/src/index.ts"],
      "@comvestec/platform": ["packages/platform/src/index.ts"],
      "@comvestec/platform/http": ["packages/platform/src/http/index.ts"],
      "@comvestec/modules": ["packages/modules/src/index.ts"]
    }
  }
}
