{
  "name": "@comvestec/saas-foundation",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check && bun run typecheck:tests",
    "dev": "turbo run dev --parallel",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "hooks:install": "node tooling/scripts/setup-hooks.mjs",
    "lint": "turbo run lint",
    "prepare": "bun run hooks:install",
    "branch:check": "node tooling/scripts/validate-branch-name.mjs",
    "push:check": "node tooling/scripts/validate-pre-push.mjs",
    "staged:check": "node tooling/scripts/validate-staged-groups.mjs",
    "commit:check": "bunx commitlint --edit",
    "test": "bunx jest --config jest.config.cjs --runInBand",
    "test:coverage": "bunx jest --config jest.config.cjs --coverage --runInBand",
    "test:watch": "bunx jest --config jest.config.cjs --watch --runInBand",
    "test:e2e": "bun run --cwd packages/e2e test:e2e",
    "test:e2e:ui": "bun run --cwd packages/e2e test:e2e:ui",
    "typecheck": "bun run typecheck:workspace && bun run typecheck:tests",
    "typecheck:tests": "bunx tsc --noEmit -p tsconfig.test.json",
    "typecheck:workspace": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.59.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "effect": "^3.21.0",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "ts-jest": "^29.4.9",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "@tanstack/start-server-core": "file:./vendor/tanstack-start-server-core",
    "h3": "2.0.1-rc.20",
    "h3-v2": "npm:h3@2.0.1-rc.20"
  }
}
