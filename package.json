{
  "name": "@comvestec/saas-foundation",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend:subscriber-journey": "bun run tooling/scripts/run-subscriber-journey-api.ts",
    "backend:subscriber-journey:bootstrap": "bun run tooling/scripts/subscriber-journey/bootstrap.ts",
    "backend:subscriber-journey:bootstrap:local": "bun run ops:local:command -- bun run tooling/scripts/subscriber-journey/bootstrap.ts",
    "backend:subscriber-journey:forward-polar-webhooks": "bun run tooling/scripts/subscriber-journey/forward-polar-webhooks.ts",
    "backend:subscriber-journey:local": "bun run ops:local:command -- bun run tooling/scripts/run-subscriber-journey-api.ts",
    "backend:subscriber-journey:ready": "bun run tooling/scripts/subscriber-journey/ready.ts",
    "backend:subscriber-journey:ready:local": "bun run ops:local:command -- bun run tooling/scripts/subscriber-journey/ready.ts",
    "backend:subscriber-journey:repair-plans": "bun run tooling/scripts/subscriber-journey/repair-polar-plans.ts",
    "backend:subscriber-journey:seed-plans": "bun run tooling/scripts/subscriber-journey/seed-polar-plans.ts",
    "backend:subscriber-journey:live-smoke": "bun run tooling/scripts/subscriber-journey/live-smoke.ts",
    "backend:subscriber-journey:live-smoke:local": "bun run ops:local:command -- bun run tooling/scripts/subscriber-journey/live-smoke.ts",
    "apps:admin:dev:local": "bun run ops:local:command -- --in apps/admin-app bun run dev",
    "apps:product:dev:local": "bun run ops:local:command -- --in apps/product-app bun run dev",
    "apps:public-web:dev:local": "bun run ops:local:command -- --in apps/public-web bun run dev",
    "build": "turbo run build",
    "check": "bun run typecheck",
    "check:typecheck-coverage": "bun run tooling/scripts/check-typecheck-coverage.ts",
    "convex:env:sync": "bun run tooling/scripts/convex/sync-environment.ts",
    "convex:env:sync:local": "bun run ops:local:command -- bun run tooling/scripts/convex/sync-environment.ts",
    "convex:deploy:local": "bun run ops:local:command -- bun run tooling/scripts/convex/deploy-self-hosted.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:local": "bun run ops:local:command -- drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:local": "bun run ops:local:command -- drizzle-kit migrate --config drizzle.config.ts",
    "dev": "turbo run dev --parallel",
    "format": "bunx prettier --write .",
    "format:check": "bun run tooling/scripts/validation/run-selective-format-check.ts",
    "format:check:all": "bunx prettier --check .",
    "hooks:install": "bun run tooling/scripts/setup-hooks.mjs",
    "lint": "turbo run lint",
    "ops:secrets:bootstrap": "bun --no-env-file run tooling/scripts/ops/bootstrap-local-secrets.ts",
    "ops:runtime:bootstrap": "bun --no-env-file run tooling/scripts/ops/bootstrap-runtime-credentials.ts",
    "ops:keycloak:provision-admin-operator": "bun --no-env-file run tooling/scripts/ops/provision-admin-operator.ts",
    "ops:keycloak:provision-admin-operator:local": "bun run ops:local:command -- bun run tooling/scripts/ops/provision-admin-operator.ts",
    "ops:docker:compose": "bun --no-env-file run tooling/scripts/ops/docker-compose.ts",
    "ops:docker:validate-local": "bun --no-env-file run tooling/scripts/ops/validate-local-deployment.ts",
    "ops:local:command": "bun --no-env-file run tooling/scripts/ops/run-local-command.ts",
    "prepare": "bun run hooks:install",
    "branch:check": "bun run tooling/scripts/validate-branch-name.mjs",
    "check:convex-generated": "bun run tooling/scripts/check-convex-generated.ts",
    "push:check": "bun run tooling/scripts/validate-pre-push.mjs",
    "staged:check": "bun run tooling/scripts/validate-staged-groups.mjs",
    "commit:check": "bunx commitlint --edit",
    "test": "bun run tooling/scripts/tests/run-selective-tests.ts",
    "test:all": "bun run test:backend && bun run test:browser",
    "test:backend": "bunx vitest run --config vitest.config.ts --project backend",
    "test:backend:e2e": "bunx vitest run --config vitest.config.ts --project backend-e2e",
    "test:backend:e2e:local": "bun run backend:subscriber-journey:bootstrap:local && bun run convex:deploy:local && bun run ops:local:command -- bunx vitest run --config vitest.config.ts --project backend-e2e",
    "test:browser": "bunx vitest run --config vitest.config.ts --project ui-browser --project admin-browser --project product-browser --project public-web-browser --passWithNoTests",
    "test:browser:admin": "bunx vitest run --config vitest.config.ts --project admin-browser --passWithNoTests",
    "test:browser:product": "bunx vitest run --config vitest.config.ts --project product-browser --passWithNoTests",
    "test:browser:public-web": "bunx vitest run --config vitest.config.ts --project public-web-browser --passWithNoTests",
    "test:browser:ui": "bunx vitest run --config vitest.config.ts --project ui-browser --passWithNoTests",
    "test:coverage": "bunx vitest run --config vitest.config.ts --project backend --coverage.enabled",
    "test:watch": "bunx vitest --config vitest.config.ts --project backend",
    "test:e2e": "bun run --cwd packages/e2e test:e2e",
    "test:e2e:local": "bun run ops:local:command -- bun run tooling/scripts/tests/run-local-admin-playwright.ts e2e",
    "test:e2e:ui": "bun run --cwd packages/e2e test:e2e:ui",
    "test:visual": "bun run --cwd packages/e2e test:visual",
    "test:visual:local": "bun run ops:local:command -- bun run tooling/scripts/tests/run-local-admin-playwright.ts visual",
    "test:a11y": "bun run --cwd packages/e2e test:a11y",
    "test:a11y:local": "bun run ops:local:command -- bun run tooling/scripts/tests/run-local-admin-playwright.ts a11y",
    "test:admin:local": "bun run ops:local:command -- bun run tooling/scripts/tests/run-local-admin-playwright.ts all",
    "typecheck": "bun run tooling/scripts/validation/run-selective-typecheck.ts",
    "typecheck:all": "bun run check:typecheck-coverage && bun run typecheck:workspace && bun run typecheck:convex && bun run typecheck:tooling && bun run typecheck:tests",
    "typecheck:convex": "bun run check:convex-generated && bunx tsc --noEmit -p tsconfig.convex.json",
    "typecheck:tooling": "bunx tsc --noEmit -p tsconfig.tooling.json",
    "typecheck:tests": "bunx tsc --noEmit -p tsconfig.test.json",
    "typecheck:workspace": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.6",
    "@vitest/coverage-v8": "^4.1.6",
    "convex": "^1.38.0",
    "drizzle-kit": "^0.31.10",
    "effect": "^3.21.2",
    "h3-v2": "npm:h3@2.0.1-rc.22",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@tanstack/start-server-core": "file:./vendor/tanstack-start-server-core",
    "h3": "2.0.1-rc.22",
    "h3-v2": "npm:h3@2.0.1-rc.22"
  }
}
